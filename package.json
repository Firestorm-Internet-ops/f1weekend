{
  "name": "pitlane",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:init": "tsx scripts/init-db.ts",
    "db:push": "drizzle-kit push --force",
    "db:seed-experiences": "tsx src/data/seed-experiences.ts",
    "db:enrich-seo": "npx tsx --env-file=.env scripts/enrich-seo-content.ts",
    "db:enrich-seo-shanghai": "npx tsx --env-file=.env scripts/enrich-seo-content.ts --race shanghai-2026 --featured-only",
    "db:patch-shanghai-prices": "npx tsx --env-file=.env scripts/patch-shanghai-gyg-prices.ts",
    "og:generate": "tsx scripts/generate-og-images.ts",
    "discover": "tsx --env-file=.env scripts/discover-gyg-tours.ts",
    "select-candidates": "tsx --env-file=.env scripts/select-candidates.ts",
    "seed-candidates": "tsx --env-file=.env scripts/seed-from-candidates.ts",
    "enrich-gyg": "tsx --env-file=.env scripts/enrich-from-gyg.ts",
    "enrich-seo": "tsx --env-file=.env scripts/enrich-seo-content.ts",
    "patch:miami-schedule": "tsx --env-file=.env scripts/patch-miami-2026-schedule.ts",
    "audit:nearby": "tsx scripts/audit-nearby.ts",
    "test:nearby": "tsx --test src/lib/nearby.test.ts src/lib/distance-map.test.ts src/lib/content-corrections.test.ts",
    "test:providers": "tsx --test src/lib/providers/providers.test.ts src/lib/providers/nearby-feed.test.ts src/lib/providers/feed-enrich.test.ts src/lib/providers/campaign.test.ts src/data/calendar-2026.test.ts src/lib/jolpica.test.ts src/lib/itinerary-feed.test.ts src/lib/next-season.test.ts src/lib/rollover.test.ts src/lib/map-groups.test.ts src/lib/unique-data.test.ts src/data/answers-2026.test.ts src/data/clusters-2026.test.ts src/lib/track-outline.test.ts",
    "db:sync-calendar": "tsx scripts/sync-calendar-2026.ts",
    "db:migrate-offers": "tsx scripts/migrate-add-experience-offers.ts",
    "offers:fetch": "tsx scripts/fetch-provider-offers.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@google-cloud/cloud-sql-connector": "^1.9.1",
    "@qdrant/js-client-rest": "^1.17.0",
    "@react-google-maps/api": "^2.20.8",
    "@vercel/analytics": "^1.6.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "ioredis": "^5.9.3",
    "marked": "^17.0.3",
    "mysql2": "^3.17.4",
    "nanoid": "^5.1.6",
    "next": "16.1.6",
    "ollama": "^0.6.3",
    "postcss": "^8.5.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/marked": "^5.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
}
